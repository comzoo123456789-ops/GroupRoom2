{
  "name": "grouproom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GroupRoom — 프리미엄 사내 회의실 예약 SaaS (Cloudflare Workers + D1 + Durable Objects)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply grouproom-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply grouproom-db --remote"
  },
  "dependencies": {
    "hono": "^4.12.31",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "~5.9.2",
    "vite": "^8.1.0",
    "wrangler": "^4.114.0"
  }
}
